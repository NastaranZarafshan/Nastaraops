# Local development template. scripts/setup.ps1 generates strong credentials in .env.
# Do not commit .env or modify POSTGRES_PASSWORD after initial database creation.
APP_ENV=development
API_KEY=REPLACE_WITH_RANDOM_SECRET
POSTGRES_DB=agents
POSTGRES_USER=agents
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql+asyncpg://agents:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:15432/agents
CHECKPOINT_DSN=postgresql://agents:REPLACE_WITH_RANDOM_PASSWORD@127.0.0.1:15432/agents
REDIS_URL=redis://127.0.0.1:16379/0
MCP_URL=http://127.0.0.1:8001/mcp
LLM_MODE=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=bge-m3
QDRANT_URL=http://127.0.0.1:16333
QDRANT_COLLECTION=nastaraops_native_knowledge
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.35
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=180
MODEL_TIMEOUT_SECONDS=120
MAX_UPLOAD_BYTES=5242880
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_SECONDS=60
NASTARAOPS_PORT=8010
